{
	"name": "ziga",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "pnpm infra:up && pnpm dev:apps",
		"build": "turbo run build",
		"lint": "turbo run lint && prettier --check .",
		"format": "prettier --write .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:unit": "turbo run test:unit",
		"test:integration": "turbo run test:integration",
		"test:e2e": "turbo run test:e2e",
		"db:migrate": "pnpm --filter @ziga/shared build && pnpm --filter @ziga/api db:migrate",
		"db:seed": "pnpm --filter @ziga/shared build && pnpm --filter @ziga/api db:seed",
		"infra:up": "bash scripts/infra-up.sh",
		"infra:down": "docker compose -f infra/docker-compose.dev.yml down",
		"dev:apps": "turbo run dev --filter=@ziga/api --filter=@ziga/web"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "26.6.6",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"turbo": "2.11.10",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1"
	}
}
