{
	"name": "@ziga/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nest build",
		"build:deps": "pnpm --filter @ziga/shared build",
		"dev": "node scripts/dev.mjs",
		"start": "node dist/main.js",
		"start:worker": "node dist/worker.js",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --config vitest.config.ts && vitest run --config vitest.integration.config.ts",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"db:migrate": "pnpm run build:deps && nest build && node --env-file-if-exists=../../.env dist/db/migrate.cli.js",
		"db:seed": "pnpm run build:deps && nest build && node --env-file-if-exists=../../.env dist/db/seed.cli.js",
		"db:generate": "drizzle-kit generate",
		"auth:keygen": "pnpm run build:deps && nest build && node dist/modules/identity/keygen.cli.js",
		"admin:create-super-admin": "pnpm run build:deps && nest build && node --env-file-if-exists=../../.env dist/modules/identity/create-super-admin.cli.js"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1164.0",
		"@aws-sdk/s3-request-presigner": "3.1164.0",
		"@bull-board/api": "9.12.0",
		"@bull-board/express": "9.12.0",
		"@nestjs/bullmq": "12.0.1",
		"@nestjs/common": "12.4.0",
		"@nestjs/core": "12.4.0",
		"@nestjs/platform-express": "12.4.0",
		"@node-rs/argon2": "2.2.2",
		"@sentry/nestjs": "11.11.0",
		"@ziga/shared": "workspace:*",
		"bullmq": "6.7.2",
		"drizzle-orm": "0.45.4",
		"ioredis": "6.0.0",
		"jose": "6.2.16",
		"nestjs-pino": "5.3.1",
		"pg": "8.23.1",
		"pino": "10.4.0",
		"pino-http": "11.0.0",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"sharp": "0.35.5",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "12.0.12",
		"@nestjs/testing": "12.4.0",
		"@powersync/service-sync-rules": "0.45.0",
		"@swc/core": "1.16.22",
		"@types/express": "5.0.6",
		"@types/pg": "8.23.1",
		"drizzle-kit": "0.31.11",
		"pino-pretty": "13.2.0",
		"typescript": "6.0.3",
		"unplugin-swc": "2.0.0",
		"vitest": "5.1.0"
	}
}
