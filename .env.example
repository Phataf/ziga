# Copier en .env pour le développement : `cp .env.example .env`.
# Aucune valeur de ce fichier n'est un vrai secret : en production, chaque valeur vient du gestionnaire de secrets.

NODE_ENV=development
LOG_LEVEL=info
# Journaux lisibles en développement (pino-pretty) ; JSON brut si false.
LOG_PRETTY=true

# --- API (HTTP) ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
# Adresse publique de l'API (D28) : https://api.ziga.com en production, https://api.ziga-staging.com en préproduction.
API_PUBLIC_URL=http://localhost:3000
# Origines du web autorisées, séparées par des virgules (CORS et routes à cookie) :
# https://ziga.com en production ; ici le serveur de développement et l'aperçu de production du web.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Authentification (lot 02) ---------------------------------------------------
# Clés de signature des jetons d'accès (Ed25519, « kid:clé », la première signe) et secret des codes SMS.
# Vides en développement : clé et secret éphémères à chaque démarrage. Obligatoires en production :
# `pnpm --filter @ziga/api auth:keygen` affiche deux lignes à placer dans le gestionnaire de secrets.
AUTH_JWT_KEYS=
AUTH_OTP_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
# Cookie de rafraîchissement, posé par l'API sur son seul hôte (préfixe __Host-, D28).
AUTH_REFRESH_COOKIE=__Host-ziga_rt
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Débit : limite principale par numéro ; plafond large par adresse IP (beaucoup d'abonnés mobiles la partagent).
RATE_LIMIT_LOGIN_PER_PHONE_PER_MINUTE=5
RATE_LIMIT_PER_IP_PER_MINUTE=300
OTP_SEND_INTERVAL_SECONDS=60
OTP_SEND_PER_PHONE_PER_HOUR=5
# Échecs de connexion : délai de 1 s, 2 s, 4 s… jusqu'à 60 s, par numéro et par adresse IP
# (l'adresse IP a d'abord une marge d'échecs).
AUTH_FAILURE_BASE_DELAY_MS=1000
AUTH_FAILURE_MAX_DELAY_MS=60000
AUTH_IP_FAILURE_ALLOWANCE=20
# SMS : « console » écrit les SMS sur une ligne à part de la sortie de l'API (jamais dans les journaux),
# « file » les ajoute à SMS_FILE (tests de bout en bout). Pas encore de prestataire réel : refusé en production.
SMS_DRIVER=console
SMS_FILE=.data/sms.log

# --- PostgreSQL 16 -------------------------------------------------------------
# Port 55432 : celui du conteneur de infra/docker-compose.dev.yml (le 5432 reste libre pour un PostgreSQL local).
# Rôle de l'API et du worker : app_api, sans BYPASSRLS. Son mot de passe est fixé par `pnpm db:migrate`.
DATABASE_URL=postgres://app_api:app_api_dev@localhost:55432/ziga
# Rôle du back-office (lot 04), distinct de app_api : connexion séparée, réservée aux routes /admin.
# Obligatoire en production ; sans elle, le back-office répond « indisponible ».
DATABASE_ADMIN_URL=postgres://app_admin:app_admin_dev@localhost:55432/ziga
DATABASE_ADMIN_POOL_MAX=3
# Propriétaire du schéma, utilisé seulement par les migrations (crée les tables, les rôles et les politiques).
DATABASE_MIGRATION_URL=postgres://ziga:ziga_dev@localhost:55432/ziga
# Connexions par processus (API ou worker) : à multiplier par le nombre d'instances, sous max_connections
# (ou sous la taille du pool de PgBouncer en mode transaction).
DATABASE_POOL_MAX=10
# Délai maximal de chaque requête, appliqué par SET LOCAL statement_timeout dans chaque transaction.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_CONNECTION_TIMEOUT_MS=5000
# Mot de passe des comptes de démonstration créés par `pnpm db:seed` (jamais en production).
SEED_DEMO_PASSWORD=demo-ziga-2026

# --- Redis (BullMQ) -------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Stockage de fichiers ---------------------------------------------------------
# s3 : SeaweedFS de infra/docker-compose.dev.yml (D27), ou le fournisseur S3 en production.
# local : dossier local, pour le développement sans Docker et les tests (refusé en production).
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=.data/storage
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=ziga-dev
S3_ACCESS_KEY_ID=ziga_dev_access
S3_SECRET_ACCESS_KEY=ziga_dev_secret
S3_FORCE_PATH_STYLE=true

# --- Erreurs (Sentry) -------------------------------------------------------------
# Vide : Sentry désactivé.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Tâches de fond ---------------------------------------------------------------
# Tableau de bord des files sur /admin/queues (toujours coupé en production).
JOBS_DASHBOARD=true
# Tâches traitées en parallèle par chaque processus worker.
WORKER_CONCURRENCY=5

# --- Arrêt et santé ---------------------------------------------------------------
# Délai laissé aux requêtes et aux tâches en cours avant l'arrêt forcé.
SHUTDOWN_TIMEOUT_MS=25000
# Délai de chaque vérification de /health/ready.
HEALTH_CHECK_TIMEOUT_MS=2000

# --- Tests d'intégration ------------------------------------------------------------
# Base recréée à chaque exécution des tests d'intégration (même serveur, autre nom).
TEST_DATABASE_NAME=ziga_test

# --- Application web (SvelteKit, adapter-node) -------------------------------------
WEB_PORT=5173
# Origine publique de l'application (paths.origin de SvelteKit 3) : https://ziga.com en production.
PUBLIC_ORIGIN=http://localhost:5173
# Adresse de l'API appelée par le navigateur : https://api.ziga.com en production.
PUBLIC_API_URL=http://localhost:3000

# --- Interrupteurs et abonnements (lot 04) -------------------------------------
# Copie locale des interrupteurs (secondes, 25 au plus) : un changement arrive partout en moins de 30 s.
FEATURES_CACHE_TTL_SECONDS=15
# Abonnement échu : rappel N jours avant la fin, puis délai de grâce avant le blocage des seules créations.
SUBSCRIPTION_REMINDER_DAYS=7
SUBSCRIPTION_GRACE_DAYS=15
